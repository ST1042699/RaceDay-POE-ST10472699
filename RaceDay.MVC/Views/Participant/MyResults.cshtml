@model List<ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<h1 class="page-heading">My Race Results</h1>
<p class="text-secondary">Your recorded finish times and race positions.</p>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Category</th>
                <th>Finish Time</th>
                <th>Position</th>
                <th>Recorded</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.OrderBy(r => r.RecordedAt))
            {
                <tr>
                    <td>@result.Event</td>
                    <td>@result.Category</td>
                    <td><strong>@result.CompletionTime</strong></td>
                    <td><span class="badge text-bg-success">#@result.RankPosition</span></td>
                    <td>@result.RecordedAt.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Your results will appear here after an organiser records them.
    </div>
}