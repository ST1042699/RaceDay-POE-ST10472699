@model List<MyEnrolmentViewModel>
@{
    ViewData["Title"] = "My Events";
}

<h1 class="page-heading">My Events</h1>
<p class="text-secondary">Your event entries and enrolment dates.</p>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Category</th>
                <th>Event Date</th>
                <th>Enrolment Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Event</td>
                    <td>@item.Category</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@item.EnrolledAt.ToString("dd MMM yyyy")</td>
                    <td><span class="badge status-confirmed">Enrolled</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have not entered any events yet.
        <a asp-controller="Home" asp-action="Index">Browse events</a>.
    </div>
}