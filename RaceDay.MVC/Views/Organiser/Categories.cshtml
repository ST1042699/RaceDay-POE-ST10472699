@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Event Categories";
    var eventId = (int)ViewBag.EventId;
}

<h1 class="page-heading">Event Categories</h1>

<div class="form-card mb-4">
    <h2 class="h5">Add a Category</h2>
    <form asp-action="CreateCategory" asp-route-id="@eventId" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Category name</label>
            <input name="CategoryName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Distance (km)</label>
            <input name="DistanceKM" type="number" min="0.01" step="0.01"
                   class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Entry fee (R)</label>
            <input name="EntryFee" type="number" min="0" step="0.01"
                   class="form-control" required />
        </div>
        <button class="btn btn-raceday">Add Category</button>
    </form>
</div>

<table class="table table-hover">
    <thead><tr><th>Category</th><th>Distance</th><th>Entry fee</th></tr></thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.CategoryName</td>
                <td>@category.DistanceKM km</td>
                <td>R @category.EntryFee.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>