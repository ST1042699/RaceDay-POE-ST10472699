@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="form-card">
    <h1 class="page-heading">Join RaceDay</h1>
    <p class="text-secondary">Create your account to get started.</p>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full name</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email address</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleId" class="form-label">Account type</label>
            <select asp-for="RoleId" class="form-select">
                <option value="2">Participant</option>
                <option value="1">Organiser</option>
            </select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-raceday w-100">Create Account</button>
    </form>
</div>