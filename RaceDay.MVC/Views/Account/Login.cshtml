@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="form-card">
    <h1 class="page-heading">Welcome back</h1>
    <p class="text-secondary">Sign in to your RaceDay account.</p>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email address</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password"
                   class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-raceday w-100">Login</button>
    </form>

    <p class="mt-3">
        New to RaceDay?
        <a asp-action="Register">Create an account</a>
    </p>
</div>